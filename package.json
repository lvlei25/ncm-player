{
  "name": "ncm-player",
  "private": true,
  "version": "1.0.0",
  "description": "网易云音乐桌面播放器 · 基于 ncm-cli 能力层",
  "author": "ncm-player",
  "homepage": "https://music.163.com/st/ncmcli",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n RENDERER,MAIN,SHELL -c cyan,magenta,green \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "node scripts/build-electron.mjs --watch",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env NCM_DEV_SERVER=http://127.0.0.1:5173 electron . --no-sandbox",
    "dev:web": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "tsc -b && vite build",
    "build:main": "node scripts/build-electron.mjs",
    "start": "electron . --no-sandbox",
    "tauri": "tauri",
    "dist": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.9",
    "@tauri-apps/api": "^2.12.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "postcss": "^8.5.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  }
}
